# Copy to .env and fill in. .env is gitignored -- never commit real values.

# --- SFTP credentials, one var per district ---
# Var name must match the district's `password_env` in config/districts.yml.
SFTP_PASSWORD_STEADFAST_BACKPACK_8880=

# --- AI content generation ---
# Used by src/drift_engine/content.py to generate realistic names, emails and
# guardian details. If unset, the engine automatically falls back to its canned
# realistic-value pool and logs that it did so -- runs never fail for want of a
# key. See docs/RUNBOOK.md.
ANTHROPIC_API_KEY=
DRIFT_CONTENT_MODEL=claude-haiku-4-5-20251001

# Set to 1 to force the canned pool and skip AI entirely.
DRIFT_CONTENT_CANNED_ONLY=0
